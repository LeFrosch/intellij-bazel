<idea-plugin>
  <extensions defaultExtensionNs="com.google.idea.blaze">
    <AspectStrategyProvider
        implementation="com.google.idea.blaze.base.sync.aspect2.Aspect2Strategy$Provider"
        order="first"/>
    <AspectWriter
        implementation="com.google.idea.blaze.base.sync.aspect2.Aspect2Writer"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <registryKey
        key="bazel.sync.use.split.aspect"
        defaultValue="false"
        description="Use the new split aspect (intellij_aspect_sdk) materialized at .clwb/aspect2 instead of the bundled aspect."/>
  </extensions>
</idea-plugin>
